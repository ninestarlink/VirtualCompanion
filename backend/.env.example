# 密钥与配置全部通过环境变量读取，严禁写死到前端代码或提交真实密钥到仓库
# 在 https://open.bigmodel.cn 控制台创建 API Key（GLM-4-Flash 有免费额度）
ZHIPU_API_KEY=
ZHIPU_CHAT_MODEL=glm-4-flash
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4
# 萌妹语音（Edge 在线 TTS，免费无 Key）；可选其他中文女声如 zh-CN-XiaoxiaoNeural
TTS_VOICE=zh-CN-XiaoyiNeural
# TTS 引擎：genie=本地菲比音色（需 backend/models/genie），edge=Edge 晓伊；genie 失败自动回退 edge
TTS_ENGINE=edge
# 服务端语音识别（硅基流动），在 https://cloud.siliconflow.cn 控制台创建 API Key
SILICONFLOW_API_KEY=
SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall
